---
import type { CollectionEntry } from 'astro:content';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;
const isExternal = data.type === 'external';
const href = isExternal ? data.externalUrl : `/writing/${publication.id}/`;
const hasLink = Boolean(href) && data.status !== 'forthcoming';
const formattedDate = data.datePublished?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const statusLabel = data.status === 'forthcoming' ? 'Forthcoming' : formattedDate;
---

<article class="publication-card">
  <div class="publication-meta">
    <span>{data.area}</span>
    <span aria-hidden="true">·</span>
    <span>{data.venue ?? (isExternal ? 'Published elsewhere' : 'Sergey Kyunttsel')}</span>
    {statusLabel && <><span aria-hidden="true">·</span><span>{statusLabel}</span></>}
  </div>

  <h2>
    {hasLink ? (
      <a href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>{data.title}</a>
    ) : data.title}
  </h2>
  <p>{data.deck}</p>

  {hasLink && (
    <a class="publication-link" href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
      {isExternal ? 'Read at original source ↗' : 'Read article →'}
    </a>
  )}
</article>
